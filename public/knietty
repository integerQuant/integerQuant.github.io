#!/bin/sh

set -eu

base_url=${KNIETTY_INSTALLER_BASE_URL:-https://github.com/integerQuant/crosspoint-reader/releases/latest/download}

fail() {
    printf 'knietty bootstrap: %s\n' "$*" >&2
    exit 1
}

command -v curl >/dev/null 2>&1 || fail 'curl is required'

tmp_dir=$(mktemp -d "${TMPDIR:-/tmp}/knietty-bootstrap.XXXXXX") ||
    fail 'could not create a temporary directory'
cleanup() {
    rm -rf "$tmp_dir"
}
trap cleanup EXIT HUP INT TERM

installer=$tmp_dir/knietty-install.sh
checksum=$tmp_dir/knietty-install.sh.sha256
curl -fsSL "${base_url%/}/knietty-install.sh" -o "$installer" ||
    fail 'could not download the canonical installer'
curl -fsSL "${base_url%/}/knietty-install.sh.sha256" -o "$checksum" ||
    fail 'could not download the installer checksum'

expected=$(awk 'NR == 1 { print $1 }' "$checksum")
case "$expected" in
    '' | *[!0-9A-Fa-f]*) fail 'installer checksum is malformed' ;;
esac
[ "${#expected}" -eq 64 ] || fail 'installer checksum is malformed'

if command -v sha256sum >/dev/null 2>&1; then
    actual=$(sha256sum "$installer" | awk '{ print $1 }')
elif command -v shasum >/dev/null 2>&1; then
    actual=$(shasum -a 256 "$installer" | awk '{ print $1 }')
else
    fail 'sha256sum or shasum is required'
fi
[ "$actual" = "$expected" ] || fail 'installer checksum verification failed'

sh "$installer" "$@"
